{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zephyr-mesh.dev/schemas/s7-swarm-run-1.json",
  "title": "Zephyr Mesh S7 swarm replay",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "seed", "dt_s", "steps", "link_events", "agent_profiles", "scenario_id", "evidence_boundary", "generation_command", "status", "command_authority", "failsafe"],
  "properties": {
    "schema": {"const": "zephyr-s7-swarm-run-1"}, "seed": {"type": "integer", "minimum": 0},
    "dt_s": {"type": "number", "exclusiveMinimum": 0}, "scenario_id": {"type": "string", "minLength": 1},
    "evidence_boundary": {"type": "string", "minLength": 1}, "generation_command": {"type": "string", "minLength": 1},
    "status": {"const": "synthetic deterministic replay; not flight performance"},
    "command_authority": {"const": "replay only"}, "failsafe": {"type": "string", "minLength": 1},
    "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}},
    "link_events": {"type": "array", "items": {"$ref": "#/$defs/linkEvent"}},
    "agent_profiles": {"type": "array", "items": {"$ref": "#/$defs/profile"}}
  },
  "$defs": {
    "vector": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}], "items": false, "minItems": 3, "maxItems": 3},
    "step": {"type": "object", "additionalProperties": false, "required": ["step_index", "time_s", "target_position_m", "active_count", "agents"], "properties": {"step_index": {"type": "integer", "minimum": 0}, "time_s": {"type": "number", "minimum": 0}, "target_position_m": {"$ref": "#/$defs/vector"}, "active_count": {"type": "integer", "minimum": 0}, "agents": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/agent"}}}},
    "agent": {"type": "object", "additionalProperties": false, "required": ["agent_id", "profile_id", "active", "position_m", "velocity_mps", "target_estimate_m", "fused_target_m", "target_source_time_s", "target_age_s", "neighbor_count", "min_neighbor_distance_m", "constraint_flags"], "properties": {"agent_id": {"type": "string", "minLength": 1}, "profile_id": {"type": "string", "minLength": 1}, "active": {"type": "boolean"}, "position_m": {"$ref": "#/$defs/vector"}, "velocity_mps": {"$ref": "#/$defs/vector"}, "target_estimate_m": {"anyOf": [{"$ref": "#/$defs/vector"}, {"type": "null"}]}, "fused_target_m": {"anyOf": [{"$ref": "#/$defs/vector"}, {"type": "null"}]}, "target_source_time_s": {"type": ["number", "null"], "minimum": 0}, "target_age_s": {"type": ["number", "null"], "minimum": 0}, "neighbor_count": {"type": "integer", "minimum": 0}, "min_neighbor_distance_m": {"type": ["number", "null"], "minimum": 0}, "constraint_flags": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "linkEvent": {"type": "object", "additionalProperties": false, "required": ["sender", "receiver", "seq", "send_time", "receive_time", "duplicate", "out_of_order", "loss_reason", "packet_age"], "properties": {"sender": {"type": "string", "minLength": 1}, "receiver": {"type": "string", "minLength": 1}, "seq": {"type": "integer", "minimum": 0}, "send_time": {"type": "number", "minimum": 0}, "receive_time": {"type": ["number", "null"], "minimum": 0}, "duplicate": {"type": "boolean"}, "out_of_order": {"type": "boolean"}, "loss_reason": {"type": ["string", "null"], "minLength": 1}, "packet_age": {"type": ["number", "null"], "minimum": 0}}, "oneOf": [{"properties": {"receive_time": {"type": "number"}, "loss_reason": {"type": "null"}, "packet_age": {"type": "number"}}}, {"properties": {"receive_time": {"type": "null"}, "loss_reason": {"type": "string", "minLength": 1}, "packet_age": {"type": "null"}}}, {"properties": {"receive_time": {"type": "null"}, "loss_reason": {"type": "null"}, "packet_age": {"type": "null"}}}]},
    "part": {"type": "object", "additionalProperties": false, "required": ["part_id", "max_torque_nm", "max_power_w", "max_rpm", "mass_kg", "nominal_voltage_v"], "properties": {"part_id": {"type": "string", "minLength": 1}, "max_torque_nm": {"type": "number", "exclusiveMinimum": 0}, "max_power_w": {"type": "number", "exclusiveMinimum": 0}, "max_rpm": {"type": "number", "exclusiveMinimum": 0}, "mass_kg": {"type": "number", "exclusiveMinimum": 0}, "nominal_voltage_v": {"type": "number", "exclusiveMinimum": 0}}},
    "propeller": {"type": "object", "additionalProperties": false, "required": ["part_id", "diameter_m", "pitch_m", "max_rpm", "thrust_coefficient", "power_coefficient", "mass_kg"], "properties": {"part_id": {"type": "string", "minLength": 1}, "diameter_m": {"type": "number", "exclusiveMinimum": 0}, "pitch_m": {"type": "number", "exclusiveMinimum": 0}, "max_rpm": {"type": "number", "exclusiveMinimum": 0}, "thrust_coefficient": {"type": "number", "exclusiveMinimum": 0}, "power_coefficient": {"type": "number", "exclusiveMinimum": 0}, "mass_kg": {"type": "number", "exclusiveMinimum": 0}}},
    "profile": {"type": "object", "additionalProperties": false, "required": ["profile_id", "motor", "propeller", "motor_count", "arm_length_m", "frame_mass_kg", "battery_capacity_wh", "total_mass_kg", "estimated_max_thrust_n"], "properties": {"profile_id": {"type": "string", "minLength": 1}, "motor": {"$ref": "#/$defs/part"}, "propeller": {"$ref": "#/$defs/propeller"}, "motor_count": {"type": "integer", "minimum": 1}, "arm_length_m": {"type": "number", "exclusiveMinimum": 0}, "frame_mass_kg": {"type": "number", "exclusiveMinimum": 0}, "battery_capacity_wh": {"type": "number", "exclusiveMinimum": 0}, "total_mass_kg": {"type": "number", "exclusiveMinimum": 0}, "estimated_max_thrust_n": {"type": "number", "exclusiveMinimum": 0}}}
  }
}
