  "rules": {
    "closed_form": "iid: 3600 h (1 - p) p^m, m = floor(T h); burst: the 0.01 s chain (q0 = p r0 / (1 - p), r0 = 0.01 / burst_mean_s) seen every 100 / h slots",
    "degraded": "DEGRADED when age >= T_w, or (age_or_loss) loss over the last 20 expected sequence numbers >= 0.3; expected_next_seq = newest seq + 1 + max(0, floor((t - newest arrival) h + 1e-9)), so a packet in flight never counts as lost",
    "fraction_time_degraded": "control steps in DEGRADED (not LANDING or LANDED) over all steps",
    "interval": "exact Poisson 95 % (chi-square) on the landing count, divided by hours",
    "recommendation": "smallest T with under 1 unnecessary landing per hour (observed), T >= T_w + 0.05 s, T_w = 0.15 s; landings do not depend on T_w or the weak rule",
    "renewal": "after a landing the drone is reset at the next arrival; at most one landing per gap",
    "unnecessary_landing": "a gap between consecutive command arrivals (a, b) lands if a control step t_i in [a, b) has t_i - a >= T"
  },
