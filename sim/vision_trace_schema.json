{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zephyr-mesh.dev/schemas/vision-trace-1.json",
  "title": "Zephyr Mesh vision trace",
  "description": "Camera or tracker observations for measured or explicitly labelled synthetic captures. subject_id is capture-provided; equivalence to physical ground truth is not inferred.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "trace_id", "status", "clock_domain", "capture", "observations"],
  "properties": {
    "schema": {"const": "zephyr-vision-trace-1"},
    "trace_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["measured", "synthetic", "fixture"]},
    "clock_domain": {"enum": ["shared_monotonic", "device_and_host", "unknown"]},
    "source": {"type": "string", "minLength": 1},
    "code_revision": {"type": "string", "minLength": 1},
    "clock_uncertainty_s": {"type": ["number", "integer"], "minimum": 0},
    "notes": {"type": "string", "minLength": 1},
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_id", "device_ids", "model", "resolution_px", "frame_rate_hz"],
      "properties": {
        "source_type": {"enum": ["camera", "tracker", "recording"]},
        "source_id": {"type": "string", "minLength": 1},
        "device_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "model": {"type": "string", "minLength": 1},
        "calibration_id": {"type": "string", "minLength": 1},
        "resolution_px": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": {"type": "integer", "minimum": 1},
            "height": {"type": "integer", "minimum": 1}
          }
        },
        "frame_rate_hz": {"type": ["number", "integer", "null"], "minimum": 0}
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["observation_id", "frame_id", "subject_id", "capture_time_s", "outcome"],
        "properties": {
          "observation_id": {"type": "string", "minLength": 1},
          "frame_id": {"type": "string", "minLength": 1},
          "subject_id": {"type": "string", "minLength": 1},
          "capture_time_s": {"type": ["number", "integer"], "minimum": 0},
          "processing_time_s": {"type": ["number", "integer", "null"], "minimum": 0},
          "outcome": {"enum": ["detected", "missed", "unknown"]},
          "confidence": {"type": ["number", "integer", "null"], "minimum": 0, "maximum": 1},
          "bbox_px": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["x", "y", "width", "height"],
            "properties": {
              "x": {"type": ["number", "integer"], "minimum": 0},
              "y": {"type": ["number", "integer"], "minimum": 0},
              "width": {"type": ["number", "integer"], "exclusiveMinimum": 0},
              "height": {"type": ["number", "integer"], "exclusiveMinimum": 0}
            }
          },
          "position_m": {
            "type": ["array", "null"],
            "minItems": 3,
            "maxItems": 3,
            "items": {"type": ["number", "integer"]}
          },
          "position_frame": {"type": ["string", "null"], "minLength": 1},
          "miss_reason": {"type": ["string", "null"], "minLength": 1},
          "unknown_reason": {"type": ["string", "null"], "minLength": 1},
          "duplicate": {"type": ["boolean", "null"]},
          "out_of_order": {"type": ["boolean", "null"]}
        },
        "allOf": [
          {"if": {"properties": {"outcome": {"const": "detected"}}, "required": ["outcome"]}, "then": {"anyOf": [{"required": ["bbox_px"]}, {"required": ["position_m"]}], "properties": {"miss_reason": {"type": "null"}, "unknown_reason": {"type": "null"}}}},
          {"if": {"properties": {"outcome": {"const": "missed"}}, "required": ["outcome"]}, "then": {"required": ["miss_reason"], "properties": {"confidence": {"type": "null"}, "bbox_px": {"type": "null"}, "position_m": {"type": "null"}, "position_frame": {"type": "null"}, "unknown_reason": {"type": "null"}}}},
          {"if": {"properties": {"outcome": {"const": "unknown"}}, "required": ["outcome"]}, "then": {"required": ["unknown_reason"], "properties": {"confidence": {"type": "null"}, "bbox_px": {"type": "null"}, "position_m": {"type": "null"}, "position_frame": {"type": "null"}, "miss_reason": {"type": "null"}}}},
          {"if": {"required": ["position_m"], "properties": {"position_m": {"type": "array"}}}, "then": {"required": ["position_frame"]}},
          {"if": {"required": ["position_frame"], "properties": {"position_frame": {"type": "string"}}}, "then": {"required": ["position_m"]}}
        ]
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "measured"}}}, "then": {"required": ["source"]}},
    {"if": {"properties": {"clock_domain": {"const": "shared_monotonic"}}}, "then": {"description": "Processing time, when supplied, must not precede capture time; enforced by the Python validator."}}
  ]
}
