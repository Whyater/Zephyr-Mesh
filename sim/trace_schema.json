{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Whyater/Zephyr-Mesh/blob/main/sim/trace_schema.json",
  "title": "Zephyr Mesh ESP-NOW trace",
  "description": "Raw packet observations for measured or explicitly labelled synthetic ESP-NOW captures. Times are seconds in clock_domain; RSSI is signed dBm when supplied; null receive time means the outcome was not observed.",
  "type": "object",
  "required": ["schema", "trace_id", "status", "clock_domain", "capture", "packets"],
  "properties": {
    "schema": {"const": "zephyr-espnow-trace-1"},
    "trace_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["measured", "synthetic", "fixture"]},
    "clock_domain": {"description": "shared_monotonic permits age and ordering checks; device_and_host and unknown do not invent one-way age. sender_round_trip is echo mode (proposal): send_time_s and echo_time_s are on the sender's clock, receive_time_s is on the receiver's own clock, and one-way delay can only be ESTIMATED as (echo_time_s - send_time_s - echo_turnaround_s) / 2, which assumes the outbound and return legs take the same time on average. An echo log cannot detect a difference between the two legs.", "enum": ["shared_monotonic", "device_and_host", "unknown", "sender_round_trip"]},
    "source": {"type": ["string", "null"]},
    "code_revision": {"type": ["string", "null"]},
    "clock_uncertainty_s": {"type": ["number", "null"], "minimum": 0},
    "notes": {"type": ["string", "null"]},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instrument",
        "calibration_ref",
        "raw_sha256",
        "code_revision",
        "captured_at",
        "operator",
        "ground_truth"
      ],
      "properties": {
        "instrument": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "model",
            "settings"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "settings": {
              "type": "object"
            }
          }
        },
        "calibration_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "calibration_ref_null_reason": {
          "type": "string",
          "minLength": 1
        },
        "raw_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "code_revision": {
          "type": "string",
          "minLength": 1
        },
        "captured_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T[^ ]+(?:Z|[+-]\\d{2}:\\d{2})$"
        },
        "operator": {
          "type": "string",
          "minLength": 1
        },
        "ground_truth": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "method",
            "values",
            "uncertainty"
          ],
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1
            },
            "values": {
              "type": "object"
            },
            "uncertainty": {
              "type": "object"
            }
          }
        },
        "ground_truth_null_reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "calibration_ref": {
                "const": null
              }
            },
            "required": [
              "calibration_ref"
            ]
          },
          "then": {
            "required": [
              "calibration_ref_null_reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "calibration_ref": {
                "type": "string"
              }
            },
            "required": [
              "calibration_ref"
            ]
          },
          "then": {
            "not": {
              "required": [
                "calibration_ref_null_reason"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "ground_truth": {
                "const": null
              }
            },
            "required": [
              "ground_truth"
            ]
          },
          "then": {
            "required": [
              "ground_truth_null_reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "ground_truth": {
                "type": "object"
              }
            },
            "required": [
              "ground_truth"
            ]
          },
          "then": {
            "not": {
              "required": [
                "ground_truth_null_reason"
              ]
            }
          }
        }
      ]
    },
    "capture": {
      "description": "Capture provenance required before a trace can be labelled measured.",
      "type": "object",
      "required": ["transport", "device_ids", "firmware", "channel", "phy"],
      "properties": {
        "transport": {"const": "ESP-NOW"},
        "device_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "firmware": {"type": "string", "minLength": 1},
        "channel": {"type": ["integer", "null"], "minimum": 1, "maximum": 14},
        "phy": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "packets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["packet_id", "sender_id", "receiver_id", "sender_session_id", "seq", "send_time_s", "outcome"],
        "properties": {
          "packet_id": {"type": "string", "minLength": 1},
          "sender_id": {"type": "string", "minLength": 1},
          "receiver_id": {"type": "string", "minLength": 1},
          "sender_session_id": {"type": "string", "minLength": 1},
          "seq": {"type": "integer", "minimum": 0, "description": "Per-packet counter that must be unwrapped (monotonic, never repeating) within one sender_session_id. A wrapping hardware counter (for example uint8) is misread as duplicates unless the exporter unwraps it or supplies explicit duplicate/out_of_order flags."},
          "send_time_s": {"type": "number", "minimum": 0},
          "outcome": {"enum": ["received", "lost", "unknown"]},
          "receive_time_s": {"type": ["number", "null"], "minimum": 0},
          "callback_time_s": {"type": ["number", "null"], "minimum": 0},
          "rssi_dbm": {"type": ["number", "null"]},
          "payload_bytes": {"type": ["integer", "null"], "minimum": 0},
          "retry_count": {"type": ["integer", "null"], "minimum": 0},
          "loss_reason": {"type": ["string", "null"]},
          "unknown_reason": {"type": ["string", "null"]},
          "duplicate": {"type": ["boolean", "null"]},
          "out_of_order": {"type": ["boolean", "null"]},
          "echo_time_s": {"type": ["number", "null"], "minimum": 0, "description": "Echo mode only (clock_domain sender_round_trip): sender-clock time the echo came back. An echo proves the outbound packet arrived."},
          "echo_turnaround_s": {"type": ["number", "null"], "minimum": 0, "description": "Echo mode only: how long the receiver held the packet before echoing it, from two stamps on the receiver's clock. Requires echo_time_s."}
        },
        "allOf": [
          {
            "if": {"properties": {"outcome": {"const": "received"}}, "required": ["outcome"]},
            "then": {
              "properties": {"loss_reason": {"type": "null"}, "unknown_reason": {"type": "null"}},
              "anyOf": [
                {"properties": {"receive_time_s": {"type": "number"}}, "required": ["receive_time_s"]},
                {"properties": {"echo_time_s": {"type": "number"}}, "required": ["echo_time_s"]}
              ]
            }
          },
          {
            "if": {"properties": {"echo_time_s": {"type": "number"}}, "required": ["echo_time_s"]},
            "then": {"properties": {"outcome": {"const": "received"}}}
          },
          {
            "if": {"properties": {"echo_turnaround_s": {"type": "number"}}, "required": ["echo_turnaround_s"]},
            "then": {"properties": {"echo_time_s": {"type": "number"}}, "required": ["echo_time_s"]}
          },
          {
            "if": {"properties": {"outcome": {"const": "lost"}}, "required": ["outcome"]},
            "then": {
              "properties": {"receive_time_s": {"type": "null"}, "loss_reason": {"type": "string", "minLength": 1}, "unknown_reason": {"type": "null"}},
              "required": ["loss_reason"]
            }
          },
          {
            "if": {"properties": {"outcome": {"const": "unknown"}}, "required": ["outcome"]},
            "then": {
              "properties": {"receive_time_s": {"type": "null"}, "loss_reason": {"type": "null"}, "unknown_reason": {"type": "string", "minLength": 1}},
              "required": ["unknown_reason"]
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "measured"}}, "required": ["status"]},
      "then": {"required": ["source", "provenance"], "properties": {"source": {"type": "string", "minLength": 1}}}
    },
    {
      "if": {"not": {"properties": {"clock_domain": {"const": "sender_round_trip"}}, "required": ["clock_domain"]}},
      "then": {
        "properties": {
          "packets": {
            "items": {
              "properties": {"echo_time_s": {"type": "null"}, "echo_turnaround_s": {"type": "null"}},
              "if": {"properties": {"outcome": {"const": "received"}}, "required": ["outcome"]},
              "then": {"properties": {"receive_time_s": {"type": "number"}}, "required": ["receive_time_s"]}
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
